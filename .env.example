# Optional public build settings. No credentials are needed.
# Leave the base path empty for local preview, a custom domain, or USERNAME.github.io.
NEXT_PUBLIC_BASE_PATH=
# Example for a project repository: /pengpei-astronomy
# NEXT_PUBLIC_BASE_PATH=/pengpei-astronomy
# Site origin only; the base path is supplied separately.
NEXT_PUBLIC_SITE_URL=http://localhost:3100
NEXT_TELEMETRY_DISABLED=1
